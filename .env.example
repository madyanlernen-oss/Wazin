# =============================================================================
# Wazan Platform - Environment Configuration Template
# Copy this file to .env and configure the values for your deployment.
# Never commit real API keys or secrets to version control.
# =============================================================================

# GEMINI_API_KEY: (Required) Google Gemini API key for intelligent advisor responses
GEMINI_API_KEY="your-gemini-api-key-here"

# GEMINI_MODEL: (Optional) Preferred Gemini model name (default: gemini-2.0-flash)
GEMINI_MODEL="gemini-2.0-flash"

# GROQ_API_KEY: (Optional) Groq fallback API key used when Gemini fails or is rate-limited
GROQ_API_KEY=""

# GROQ_MODEL: (Optional) Groq model name (default: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# APP_URL: Public URL where the application is hosted
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS="https://wazin-9j3w.onrender.com,http://localhost:5173,http://localhost:3000"

# PORT: HTTP server port (default: 3000)
PORT=3000

# NODE_ENV: Runtime environment (development or production)
NODE_ENV="production"
