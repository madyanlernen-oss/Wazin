# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL: Optional preferred Gemini model name (e.g. gemini-2.0-flash, gemini-flash-lite-latest)
GEMINI_MODEL=""

# GROQ_API_KEY: Optional backup AI provider API key used when Gemini fails
GROQ_API_KEY=""

# GROQ_MODEL: Optional Groq model name (default: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# ALLOWED_ORIGINS: Comma-separated list of site URLs allowed to call the API (e.g. https://my-app.vercel.app,http://localhost:5173)
ALLOWED_ORIGINS="https://my-app.vercel.app,http://localhost:5173"

# PORT: Optional HTTP server port (default: 3000)
PORT=3000

# NODE_ENV: Optional runtime environment (development or production)
NODE_ENV="development"
